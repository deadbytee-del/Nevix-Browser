{
  "name": "nevix-browser",
  "productName": "Nevix",
  "version": "1.0.0",
  "description": "Nevix \u2014 a fast, private, bloat-free browser.",
  "main": "src/main/index.js",
  "license": "MIT",
  "author": "deadbytee-del",
  "scripts": {
    "start": "electron . --enable-features=UseOzonePlatform --ozone-platform-hint=auto",
    "start:dev": "electron . --user-data-dir=./.dev-profile",
    "test": "node test/unit.js",
    "test:e2e": "sh test/run-e2e.sh",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "icon": "xvfb-run -a electron scripts/make-icon.js --no-sandbox --disable-gpu"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "homepage": "https://github.com/deadbytee-del/Nevix-Browser",
  "build": {
    "appId": "app.nevix.browser",
    "productName": "Nevix",
    "copyright": "Copyright \u00a9 2026 deadbytee-del",
    "files": [
      "src/**/*",
      "assets/app-icon.png",
      "assets/app-icon.svg",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "electronLanguages": [
      "en-US"
    ],
    "protocols": [
      {
        "name": "Web site",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/app-icon.png",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ]
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.png",
      "executableName": "Nevix"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nevix",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Nevix-Setup.exe",
      "uninstallDisplayName": "Nevix"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser",
      "icon": "assets/app-icon.png",
      "maintainer": "deadbytee-del",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html"
      ],
      "desktop": {
        "entry": {
          "Name": "Nevix",
          "Comment": "Fast, private, bloat-free browser",
          "StartupWMClass": "Nevix",
          "Keywords": "browser;web;internet;privacy;"
        }
      },
      "executableName": "nevix"
    },
    "publish": null,
    "portable": {
      "artifactName": "Nevix-Portable.exe"
    },
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "xhtml"
        ],
        "name": "HTML document",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer"
      }
    ]
  }
}
