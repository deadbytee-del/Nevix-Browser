{
  "manifest_version": 3,
  "name": "Nevix Test Extension",
  "version": "1.2.3",
  "description": "Marks pages so tests can see that content scripts ran.",
  "permissions": ["storage", "cookies"],
  "host_permissions": ["*://*.test/*"],
  "content_scripts": [{ "matches": ["*://*.test/*"], "js": ["cs.js"], "run_at": "document_idle" }]
}
